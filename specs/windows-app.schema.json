{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omniforge.dev/windows-app/v1.schema.json",
  "title": "OmniForge Windows Desktop Adapter App Manifest v1",
  "description": "Consumed only by the windows-desktop adapter, referenced from a project's targets.windows.entry.",
  "type": "object",
  "required": ["schema", "app_name", "root"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "omniforge.dev/windows-app/v1" },
    "app_name": { "type": "string", "minLength": 1 },
    "root": {
      "type": "object",
      "required": ["component"],
      "additionalProperties": false,
      "properties": {
        "component": { "type": "string" },
        "inputs": { "type": "object" }
      }
    }
  }
}
