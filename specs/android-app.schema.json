{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omniforge.dev/android-app/v1.schema.json",
  "title": "OmniForge Android Adapter App Manifest v1",
  "description": "Consumed only by the android-gradle adapter, referenced from a project's targets.android.entry.",
  "type": "object",
  "required": ["schema", "package", "app_label", "root"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "omniforge.dev/android-app/v1" },
    "package": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "app_label": { "type": "string", "minLength": 1 },
    "min_sdk": { "type": "integer", "minimum": 21 },
    "target_sdk": { "type": "integer", "minimum": 21 },
    "compile_sdk": { "type": "integer", "minimum": 21 },
    "root": {
      "type": "object",
      "required": ["component"],
      "additionalProperties": false,
      "properties": {
        "component": { "type": "string" },
        "inputs": { "type": "object" }
      }
    }
  }
}
