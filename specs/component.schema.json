{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omniforge.dev/component/v1.schema.json",
  "title": "OmniForge Component Manifest v1",
  "type": "object",
  "required": ["schema", "name", "version", "kind"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "omniforge.dev/component/v1" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "type": "string",
      "enum": ["ui", "logic", "service", "library", "tool"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "composes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["component"],
        "additionalProperties": false,
        "properties": {
          "component": { "type": "string" },
          "inputs": { "type": "object" }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/field" }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/field" }
        },
        "events": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "implementations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["adapter", "source"],
        "additionalProperties": false,
        "properties": {
          "adapter": { "type": "string" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["string", "boolean", "number"] },
        "required": { "type": "boolean" },
        "default": {}
      }
    }
  }
}
